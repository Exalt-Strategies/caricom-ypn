{
  "$description": "Caribbean Young Parliamentarians Network — sticker-poster design system. Tokens-Studio-style shape (value + type) so it imports into Figma (Tokens Studio), Style Dictionary, or Tailwind. Responsive values keep the CSS clamp() string; the `static` field gives a single fallback for tools that need one.",
  "color": {
    "ink":         { "value": "#000000", "type": "color", "description": "Outlines, body text, page canvas, wordmark on light" },
    "paper":       { "value": "#ffffff", "type": "color", "description": "Text on dark fills, knockout, wordmark on dark" },
    "signal-red":  { "value": "#ee3835", "type": "color", "description": "Card fill, photo frames, emphasis" },
    "cobalt":      { "value": "#007df6", "type": "color", "description": "Card fill, backdrop, hero" },
    "acid-lime":   { "value": "#c3f900", "type": "color", "description": "Backdrop, high-voltage accent, CTAs" },
    "spring-mint": { "value": "#6dff80", "type": "color", "description": "Card fill, photo backdrop" },
    "lavender":    { "value": "#bea2e7", "type": "color", "description": "Soft card fill, breathing room" },
    "orchid":      { "value": "#e280fd", "type": "color", "description": "Vivid photo frame / backdrop" },
    "lemon":       { "value": "#f8eb39", "type": "color", "description": "Panel fill behind cutouts, photo frames" },
    "kelly-green": { "value": "#29b24a", "type": "color", "description": "Backdrop" },
    "coral":       { "value": "#ffabab", "type": "color", "description": "Outlined display text (the one soft tone)" }
  },
  "semantic": {
    "bg":        { "value": "{color.ink}",   "type": "color", "description": "Page canvas — black, so posters float on it" },
    "surface":   { "value": "{color.paper}", "type": "color", "description": "Default card fill (per-section overrides)" },
    "text":      { "value": "{color.ink}",   "type": "color" },
    "text-mute": { "value": "rgba(0,0,0,0.66)", "type": "color", "description": "Secondary text; ink-based so it reads on any bright card" },
    "line":      { "value": "{color.ink}",   "type": "color", "description": "The keyline is always black" },
    "accent":    { "value": "{color.cobalt}", "type": "color" },
    "accent-2":  { "value": "{color.signal-red}", "type": "color" },
    "on-accent": { "value": "{color.paper}", "type": "color" }
  },
  "typography": {
    "fontFamily":     { "value": "Inter", "type": "fontFamilies", "description": "Variable font, weights 100–900. Same family for display and UI." },
    "weight-body":    { "value": "500", "type": "fontWeights" },
    "weight-label":   { "value": "800", "type": "fontWeights" },
    "weight-heading": { "value": "800", "type": "fontWeights" },
    "headline-lineHeight":    { "value": "1.0",    "type": "lineHeights" },
    "headline-letterSpacing": { "value": "-0.02em", "type": "letterSpacing", "description": "Headlines/wordmark sit tight, near full width" },
    "label-letterSpacing":    { "value": "0.18em",  "type": "letterSpacing", "description": "Pills/eyebrows: uppercase, wide-tracked (0.18–0.22em)" },
    "body-lineHeight":        { "value": "1.4",     "type": "lineHeights" }
  },
  "borderRadius": {
    "outer": { "value": "44px", "type": "borderRadius", "description": "Section poster card (~4–5% of width)" },
    "card":  { "value": "32px", "type": "borderRadius", "description": "Inner content cards (less than parent)" },
    "photo": { "value": "22px", "type": "borderRadius", "description": "Photo frames (least rounded)" },
    "pill":  { "value": "999px", "type": "borderRadius", "description": "Pills, CTAs, arrows" }
  },
  "borderWidth": {
    "card":  { "value": "3px",  "type": "borderWidth", "description": "Black keyline on every card/poster" },
    "photo": { "value": "12px", "type": "borderWidth", "description": "Thick clashing frame around photos" },
    "pill":  { "value": "2px",  "type": "borderWidth" }
  },
  "spacing": {
    "maxw":     { "value": "1180px", "type": "sizing", "description": "Poster column max width" },
    "edge":     { "value": "clamp(14px, 3.5vw, 30px)", "static": "24px", "type": "spacing", "description": "Viewport-edge gutter — nothing touches the edge" },
    "gutter":   { "value": "clamp(18px, 2.4vw, 30px)", "static": "24px", "type": "spacing", "description": "Grid gap = card row gap" },
    "gap-stack":{ "value": "clamp(20px, 3.5vw, 44px)", "static": "40px", "type": "spacing", "description": "Space between poster sections" },
    "pad-card": { "value": "clamp(20px, 3.4vw, 44px)", "static": "40px", "type": "spacing", "description": "Poster inner padding" }
  },
  "motion": {
    "ease": { "value": "cubic-bezier(0.25, 0.1, 0.25, 1)", "type": "cubicBezier" }
  }
}
