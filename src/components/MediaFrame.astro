---
/**
 * MediaFrame — the neutral media slot. Card-shaped (radius inherited from
 * the parent .card or applied standalone), fixed aspect ratio, optional
 * caption. With no image it renders a quiet placeholder so layouts hold
 * before real assets exist.
 *
 * Treatments (duotone, tints, …) are ADD-ONS: they wrap or restyle the
 * <img> here — see addons/duotone/INSTALL.md. Keep this component neutral.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  image?: ImageMetadata;
  src?: string;        // public/ path (e.g. "/img/name.jpg") — used for runtime photos
  alt?: string;
  ratio?: string;      // CSS aspect-ratio, e.g. "1 / 1", "2 / 3", "3 / 2"
  caption?: string;
  label?: string;      // short text shown on the placeholder (and as fallback under src)
  class?: string;
  sizes?: string;
}
const {
  image,
  src,
  alt = "",
  ratio = "3 / 2",
  caption,
  label,
  class: cls = "",
  sizes = "(max-width: 860px) 100vw, 33vw",
} = Astro.props;
---

<figure class={`mf ${cls}`}>
  <div class="mf-box" style={`aspect-ratio: ${ratio}`}>
    {/* Placeholder is the base layer; a real photo covers it when present.
        If a public/ src 404s, the img removes itself and the label shows. */}
    <div class="mf-placeholder" role="img" aria-label={alt || label || "placeholder"}>
      {label && <span>{label}</span>}
    </div>
    {src ? (
      <img class="mf-photo" src={src} alt={alt} loading="lazy" onerror="this.remove()" />
    ) : image ? (
      <Image class="mf-photo" src={image} alt={alt} widths={[480, 900, 1400]} sizes={sizes} />
    ) : null}
  </div>
  {caption && <figcaption class="mf-cap">{caption}</figcaption>}
</figure>

<style>
  .mf { margin: 0; min-width: 0; }
  /* Thick, clashing photo frame — the poster signature. */
  .mf-box {
    position: relative;
    border-radius: var(--radius-photo); overflow: hidden;
    background: var(--frame-2, var(--spring-mint));
    border: var(--border-photo) solid var(--frame, var(--signal-red));
  }
  /* Photo covers the placeholder base layer; if it 404s it removes itself. */
  .mf-box :global(.mf-photo) {
    position: absolute; inset: 0; z-index: 1;
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .mf-placeholder {
    position: absolute; inset: 0;
    display: grid; place-items: center; padding: 1rem;
    background: var(--frame-2, var(--spring-mint));
  }
  .mf-placeholder span {
    font-family: var(--font-ui); font-weight: 800; font-size: 0.9rem;
    letter-spacing: 0.02em; text-transform: uppercase; color: var(--ink); text-align: center;
  }
  .mf-cap {
    font-size: 0.85rem; color: inherit; margin-top: 0.7rem; font-weight: 600;
  }
</style>
