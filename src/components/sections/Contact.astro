---
/** Recipe: CONTACT — quiet closer: text + pill link cards. No panel here;
 *  the page goes quiet after Join. */
import SectionHeader from "../SectionHeader.astro";
import { site } from "../../data/site";
const { contact } = site;
---

{contact && (
  <section class="section container" id="contact">
    <div class="card card-pad contact reveal">
      <SectionHeader eyebrow={contact.eyebrow} title={contact.title} align="start" />
      {contact.body.map((p) => <p class="contact-p">{p}</p>)}
      <div class="contact-links">
        {contact.links.map((l) => (
          <a class="clink" href={l.href}>
            <span class="clink-label t-eyebrow">{l.label}</span>
            <span class="clink-val">{l.val}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .contact-p { color: var(--text-mute); font-size: 1.02rem; line-height: 1.75; max-width: 56ch; }
  .contact-links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.75rem; }
  .clink {
    display: flex; flex-direction: column; gap: 0.2rem;
    padding: 0.9rem 1.5rem; border: 1px solid var(--line); border-radius: 999px;
    transition: border-color 0.2s var(--ease);
  }
  .clink:hover { border-color: var(--text-mute); }
  .clink-val { font-size: 0.95rem; }
</style>
