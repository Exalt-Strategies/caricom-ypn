---
/** Recipe: STATE TILES — scroll-snap row of typographic country stickers,
 *  echoing the poster country tile (wordmark + caption). Each tile clashes
 *  with its neighbour. */
import SectionHeader from "../SectionHeader.astro";
import Rail from "../Rail.astro";
import { site } from "../../data/site";
const { memberStates } = site;
---

{memberStates && (
  <section class="section container" id="memberStates">
    <SectionHeader eyebrow={memberStates.eyebrow} title={memberStates.title} lead={memberStates.lead} align="row">
      <div class="rail-arrows" slot="actions">
        <button class="rail-arrow" data-rail-prev aria-label="Previous states">←</button>
        <button class="rail-arrow" data-rail-next aria-label="More states">→</button>
      </div>
    </SectionHeader>
    <Rail label="Member states" itemWidth="min(280px, 74vw)">
      {memberStates.items.map((s) => (
        <article class="card card-pad state reveal" role="listitem">
          <span class="pill state-count">Member state</span>
          <h3 class="state-name t-display">{s.country}</h3>
          <p class="state-capital t-eyebrow">{s.capital}</p>
        </article>
      ))}
    </Rail>
  </section>
)}

<style>
  .state {
    min-height: 260px; display: flex; flex-direction: column;
    align-items: flex-start; gap: 0.9rem;
  }
  .state-count { --pill-bg: var(--ink); color: var(--paper); }
  .state-name { font-size: clamp(1.6rem, 2.4vw, 2.2rem); margin-top: auto; }
  .state-capital { opacity: 0.75; }

  /* Clash each tile against its neighbour, independent of the section rotation. */
  .state:nth-child(5n + 1) { --card-fill: var(--lemon);       --card-ink: var(--ink); }
  .state:nth-child(5n + 2) { --card-fill: var(--cobalt);      --card-ink: var(--paper); }
  .state:nth-child(5n + 3) { --card-fill: var(--spring-mint); --card-ink: var(--ink); }
  .state:nth-child(5n + 4) { --card-fill: var(--signal-red);  --card-ink: var(--paper); }
  .state:nth-child(5n + 5) { --card-fill: var(--orchid);      --card-ink: var(--ink); }
</style>
